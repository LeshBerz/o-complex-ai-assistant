# LLM: провайдер выбирается в src/lib/llm.ts (сейчас есть только openrouter)
LLM_PROVIDER=openrouter
# Бесплатные модели со structured outputs. nemotron проверена реальными вызовами на русском 2026-09-30
# (см. docs/ai-log.md); qwen в тот день отвечал только 429, dots не вызывался — оба запасные.
# При 429/ошибке OpenRouter в том же запросе переключается на следующую модель из LLM_FALLBACK_MODELS.
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
LLM_FALLBACK_MODELS=qwen/qwen3.8-27b:free,dots-studio/dots-3-note-preview:free
OPENROUTER_API_KEY=              # https://openrouter.ai/settings/keys, без карты; лимит free-моделей 50 запросов/день
LLM_TIMEOUT_MS=45000             # таймаут одной попытки, после него /api/assist отвечает 504
# Локально с VPN-прокси: Node fetch игнорирует HTTPS_PROXY и идёт напрямую из РФ, OpenRouter отвечает
# 403 "Access denied by security policy". Нужно задать NODE_USE_ENV_PROXY=1 в окружении ДО запуска node
# (в .env.local не сработает, проверено): $env:NODE_USE_ENV_PROXY=1; npm run dev. npm run eval передаёт флаг --use-env-proxy сам.

# Эмбеддинги: локально, @huggingface/transformers (ключ не нужен)
EMBEDDING_MODEL=Xenova/multilingual-e5-small

# Retrieval (необязательно, значения по умолчанию в src/lib/retrieval.ts)
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.75         # абсолютный порог cosine (у e5 баллы сжаты в 0.7–0.9)
RETRIEVAL_MAX_GAP=0.04           # максимальное отставание чанка от top-1

# amoCRM (REST API v4)
AMOCRM_MODE=mock                 # mock | live
AMOCRM_SUBDOMAIN=
AMOCRM_ACCESS_TOKEN=             # долгосрочный токен интеграции
AMOCRM_WEBHOOK_SECRET=           # секрет в query-параметре вебхука
