# LLM: OpenRouter через @openrouter/ai-sdk-provider (Vercel AI SDK)
LLM_PROVIDER=openrouter
LLM_MODEL=                       # бесплатная модель с суффиксом :free и поддержкой structured outputs; выбирает backend-dev. TODO: проверить
OPENROUTER_API_KEY=              # https://openrouter.ai/settings/keys, без карты

# Эмбеддинги: локально, @huggingface/transformers (ключ не нужен)
EMBEDDING_MODEL=Xenova/multilingual-e5-small

# amoCRM (REST API v4)
AMOCRM_MODE=mock                 # mock | live
AMOCRM_SUBDOMAIN=
AMOCRM_ACCESS_TOKEN=             # долгосрочный токен интеграции
AMOCRM_WEBHOOK_SECRET=           # секрет в query-параметре вебхука
